{
  "_about": "Fallbacks for the runner's keys in config.json, with today's values. Edit config.json, not this file: a key here is used only when config.json lacks it, or its value there has the wrong shape (the runner logs `config: <key> ...` and carries on). Each list/object here is also the shape the value must have.",
  "_complete": ["timeout_s"],
  "_complete_note": "Objects that must keep every key they have here (timeout_s needs a value for each task weight).",

  "infra_retries": 1,
  "backoff_min": 10,
  "timeout_s": {"light": 1200, "heavy": 3600},
  "timeout_min_runs": 20,
  "timeout_p95_factor": 3,
  "timeout_floor_s": 300,
  "gate_timeout_s": 600,
  "broken_gate_codes": [5, 127, 9009],
  "maint_share": 0.20,
  "maint_floor_s": 900,
  "stale_days": 7,
  "parallel_lanes": true,
  "lane_slots": {"claude": 1, "codex": 1, "copilot": 1},
  "lane_fallback": {"claude": "codex", "codex": "claude", "copilot": "claude"},

  "lane_argv": {
    "claude": ["claude", "-p", "--permission-mode", "acceptEdits", "--permission-prompts", "none",
               "--output-format", "stream-json", "--verbose",
               "--allowedTools", "Read,Edit,Write,Glob,Grep,Bash",
               "--disallowedTools", "Bash(git push:*),Bash(gh:*)"],
    "codex": ["{npm-shim:codex}", "exec", "--skip-git-repo-check", "--color", "never",
              "-c", "mcp_servers.node_repl.enabled=false",
              "-c", "mcp_servers.desktop-commander.enabled=false",
              "-c", "mcp_servers.obsidian.enabled=false",
              "-s", "danger-full-access", "-"],
    "gemini": ["node", "{npm:@google/gemini-cli:gemini}", "--approval-mode", "auto_edit", "-o", "text",
               "-p", "Do the task given above."],
    "copilot": ["{npm-shim:copilot}", "-p",
                "Your full instructions are in the file {prompt-file}. Read that file first and follow it exactly.",
                "--allow-all-tools", "--no-ask-user", "--no-color", "--no-auto-update", "--disable-builtin-mcps",
                "--deny-tool", "shell(git push)", "--deny-tool", "shell(gh)"]
  },
  "unpriced_lanes": ["codex", "gemini", "copilot"],
  "npm_dirs": ["%APPDATA%/npm", "~/AppData/Roaming/npm", "%LOCALAPPDATA%/Packages/Claude_*/LocalCache/Roaming/npm"],

  "limit_patterns": {
    "codex": ["you've hit your usage limit", "usage limit", "rate limit(ed)? (reached|exceeded)",
              "429 too many requests"],
    "claude": ["usage limit reached", "you've hit your (usage )?limit", "\\b\\d+-hour limit reached",
               "weekly limit reached", "rate limit (reached|exceeded)", "rate_limit_error"],
    "gemini": ["IneligibleTierError", "quota exceeded", "exceeded your current quota",
               "RESOURCE_EXHAUSTED", "rate limit (reached|exceeded)"],
    "copilot": ["premium requests?\\b.{0,60}\\b(limit|quota|exhausted|run out|used up)",
                "(limit|quota|allowance)\\b.{0,40}\\bpremium requests?",
                "(out of|exhausted|no remaining|used (all|up)( of)?)( your)? (premium requests|ai credits)",
                "ai credits?\\b.{0,40}\\b(exhausted|limit (reached|exceeded)|run out|used up)",
                "monthly (limit|quota|allowance) (reached|exceeded|hit)",
                "you've (hit|reached|exceeded) your .{0,40}(limit|quota)",
                "rate limit(ed)? (reached|exceeded)", "429 too many requests"]
  },
  "limit_tail_lines": 40,
  "limit_default_min": 60,

  "auth_patterns": {
    "claude": ["failed to authenticate", "oauth session expired", "please run /login", "invalid api key", "not logged in"],
    "codex": ["not logged in", "please (log|sign) in", "401 unauthorized", "authentication (failed|required)"],
    "copilot": ["not logged in", "please (log|sign) in", "authentication (failed|required)", "no authentication"],
    "gemini": ["authentication (failed|required)", "please (log|sign) in"]
  },
  "auth_retry_min": 15,
  "auth_fix_hint": "sign-in expired: open a terminal, run the lane's CLI (e.g. `claude`) and sign in (`/login`)",

  "daily_spend_cap_usd": 5.0,
  "unknown_cost_per_min_usd": 0.10,
  "done_window_days": 14,
  "status_by_prompt_days": 14,
  "status_recent_runs": 5,
  "vault_dir": "~/OneDrive - King's College London/Denisse",
  "auto_push": true,

  "review_risky": true,
  "review_max_lines": 400,
  "review_timeout_s": 900,
  "review_diff_max_chars": 150000,
  "review_risky_patterns": ["^orchestra/", "^atrium/hook\\.py$", "\\.git/hooks", "(^|/)install_[^/]*\\.ps1$"],
  "reviewer_argv": ["claude", "-p", "--permission-mode", "default", "--permission-prompts", "none",
                    "--output-format", "json",
                    "--allowedTools", "Read,Glob,Grep,Bash(git diff:*),Bash(git log:*)",
                    "--disallowedTools", "Edit,Write,MultiEdit,NotebookEdit,Bash(git push:*),Bash(gh:*)"],

  "conflict_hot_files": ["orchestra/runner.py", "orchestra/config.json", "eval/cases.py", "README.md"],
  "conflict_max_holds": 2,
  "conflict_followup": true,
  "conflict_followup_lane": "claude",
  "conflict_followup_priority": "urgent",
  "conflict_followup_suffix": "-merge",
  "conflict_map_file": "conflicts.json",
  "conflict_map_threshold": 1.0,
  "conflict_bootstrap_merges": 200,
  "conflict_min_word_len": 3,
  "conflict_both_sides_shown": 8,
  "conflict_ignore_prefixes": [".review/", ".venv/", ".git/", "node_modules/", "__pycache__/"],
  "conflict_stop_words": ["the", "and", "for", "with", "from", "into", "onto", "that", "this", "when", "then", "not",
                          "its", "are", "was", "per", "via", "one", "two", "task", "tasks", "make", "use", "add", "fix",
                          "new", "run", "runs", "should", "after", "before", "each", "every", "all", "any", "can", "don",
                          "doesn", "let", "our", "out", "over", "under", "than", "them", "they", "you", "your", "what",
                          "which", "while", "who", "how", "why", "has", "have", "had", "but", "too", "also", "only",
                          "just", "more", "most", "less", "once", "still", "stop", "keep", "keeps", "merge", "review"],

  "auto_admit_areas": [],
  "producer_queue_cap": 20,
  "producer_admit_per_hour": 4,
  "producer_dedupe_days": 30,

  "git_timeout_s": 120,
  "taskkill_timeout_s": 60,
  "process_exit_wait_timeout_s": 30,
  "tick_watchdog_extra_s": 900,
  "keep_ref_prefix": "refs/keep/",
  "keep_ref_log": "KEPT {branch}: {count} commit(s) not on master saved as {ref} before {why}; recover with `git branch <name> {ref}`",
  "merge_only_mark": "Merge-only re-queue:",
  "merge_only_paragraph": "{mark} the work for this task is already on branch `{branch}` but never reached master. The runner merges that branch onto current master itself and re-runs the gate below (plus the reviewer, if the diff is risky); no new lane runs. If the branch is missing or the merge can't run, the task is parked. Re-queued {when}{note}.",
  "merge_only_report": "RESULT: PASS\nGATE: re-run by the runner before the merge\nHUMAN: none\nPREMISE: not stated\nDONE:\n- merge-only re-queue: the runner merged the existing branch {branch}; no lane ran\n",
  "merge_only_park": "merge-only re-queue not merged: {why}. No lane was run; branch {branch} kept if it exists"
}
