{
  "permissions": {
    "allow": [
      "read_file(.)",
      "command(regex:git status( .*)?)",
      "read_file(.review)",
      "command(regex:git diff( .*)?)",
      "command(regex:git log( .*)?)",
      "command(regex:git show( .*)?)",
      "command(regex:git ls\\-files( .*)?)",
      "command(regex:type( .*)?)",
      "command(regex:cat( .*)?)",
      "command(regex:findstr( .*)?)",
      "command(regex:dir( .*)?)",
      "command(regex:ls( .*)?)",
      "command(regex:git ls-files( .*)?)",
      "command(regex:Get-Content( .*)?)",
      "command(regex:Select-String( .*)?)",
      "command(regex:Get-ChildItem( .*)?)"
    ],
    "deny": [
      "write_file(*)",
      "command(regex:git push( .*)?)",
      "command(regex:git add( .*)?)",
      "command(regex:git commit( .*)?)",
      "command(regex:git checkout( .*)?)",
      "command(regex:git reset( .*)?)",
      "command(regex:git remote( .*)?)",
      "command(regex:git config( .*)?)",
      "command(regex:gh( .*)?)",
      "command(regex:python( .*)?)",
      "command(regex:\\.venv( .*)?)",
      "command(regex:node( .*)?)",
      "command(regex:npm( .*)?)",
      "command(regex:curl( .*)?)",
      "command(regex:irm( .*)?)",
      "command(regex:iwr( .*)?)",
      "command(regex:rm( .*)?)",
      "command(regex:del( .*)?)",
      "command(regex:Remove\\-Item( .*)?)",
      "read_url(*)",
      "execute_url(*)",
      "download_url(*)",
      "mcp(*)"
    ]
  }
}
