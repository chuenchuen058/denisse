{
  "permissions": {
    "allow": [
      "read_file(.)",
      "command(git status)",
      "read_file(.review)",
      "command(git diff)",
      "command(git log)",
      "command(git show)",
      "command(git ls-files)",
      "command(type)",
      "command(cat)",
      "command(findstr)",
      "command(dir)",
      "command(ls)",
      "command(regex:git status( .*)?)",
      "command(regex:git diff( .*)?)",
      "command(regex:git log( .*)?)",
      "command(regex:git show( .*)?)",
      "command(regex:git ls-files( .*)?)",
      "command(regex:type( .*)?)",
      "command(regex:cat( .*)?)",
      "command(regex:Get-Content( .*)?)",
      "command(regex:findstr( .*)?)",
      "command(regex:Select-String( .*)?)",
      "command(regex:dir( .*)?)",
      "command(regex:ls( .*)?)",
      "command(regex:Get-ChildItem( .*)?)"
    ],
    "deny": [
      "write_file(*)",
      "command(git push)",
      "command(git add)",
      "command(git commit)",
      "command(git checkout)",
      "command(git reset)",
      "command(git remote)",
      "command(git config)",
      "command(gh)",
      "command(python)",
      "command(.venv)",
      "command(node)",
      "command(npm)",
      "command(curl)",
      "command(irm)",
      "command(iwr)",
      "command(rm)",
      "command(del)",
      "command(Remove-Item)",
      "read_url(*)",
      "execute_url(*)",
      "download_url(*)",
      "mcp(*)"
    ]
  }
}
