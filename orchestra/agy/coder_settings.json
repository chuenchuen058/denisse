{
  "permissions": {
    "allow": [
      "read_file(.)",
      "write_file(.)",
      "write_file(.review)",
      "read_file(.review)",
      "command(git status)",
      "command(git diff)",
      "command(git log)",
      "command(git show)",
      "command(git add)",
      "command(git commit)",
      "command(git rev-parse)",
      "command(git ls-files)",
      "command(npm test)",
      "command(npm run)",
      "command(cd)",
      "command(Set-Location)",
      "command(pushd)",
      "command(echo)",
      "command(Write-Output)",
      "command(Get-Content)",
      "command(type)",
      "command(dir)",
      "command(ls)",
      "command(Get-ChildItem)",
      "command(findstr)",
      "command(Select-String)",
      "command(regex:\\S*python[0-9.]*(\\.exe)? .*)",
      "command(regex:py .*)",
      "command(regex:node .*)",
      "command(regex:git status( .*)?)",
      "command(regex:git diff( .*)?)",
      "command(regex:git log( .*)?)",
      "command(regex:git show( .*)?)",
      "command(regex:git add( .*)?)",
      "command(regex:git commit( .*)?)",
      "command(regex:git rev-parse( .*)?)",
      "command(regex:git ls-files( .*)?)",
      "command(regex:npm test( .*)?)",
      "command(regex:npm run( .*)?)"
    ],
    "deny": [
      "command(git push)",
      "command(git remote)",
      "command(git config)",
      "command(gh)",
      "command(curl)",
      "command(wget)",
      "command(irm)",
      "command(iwr)",
      "command(Invoke-WebRequest)",
      "command(Invoke-RestMethod)",
      "command(rm)",
      "command(del)",
      "command(rmdir)",
      "command(Remove-Item)",
      "command(format)",
      "command(shutdown)",
      "read_url(*)",
      "execute_url(*)",
      "download_url(*)",
      "mcp(*)"
    ]
  }
}
