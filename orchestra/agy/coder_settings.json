{
  "permissions": {
    "allow": [
      "read_file(.)",
      "write_file(.)",
      "write_file(.review)",
      "read_file(.review)",
      "command(regex:git status( .*)?)",
      "command(regex:git diff( .*)?)",
      "command(regex:git log( .*)?)",
      "command(regex:git show( .*)?)",
      "command(regex:git add( .*)?)",
      "command(regex:git commit( .*)?)",
      "command(regex:git rev\\-parse( .*)?)",
      "command(regex:git ls\\-files( .*)?)",
      "command(regex:npm test( .*)?)",
      "command(regex:npm run( .*)?)",
      "command(regex:cd( .*)?)",
      "command(regex:Set\\-Location( .*)?)",
      "command(regex:pushd( .*)?)",
      "command(regex:echo( .*)?)",
      "command(regex:Write\\-Output( .*)?)",
      "command(regex:Get\\-Content( .*)?)",
      "command(regex:type( .*)?)",
      "command(regex:dir( .*)?)",
      "command(regex:ls( .*)?)",
      "command(regex:Get\\-ChildItem( .*)?)",
      "command(regex:findstr( .*)?)",
      "command(regex:Select\\-String( .*)?)",
      "command(regex:\\S*python[0-9.]*(\\.exe)? .*)",
      "command(regex:py .*)",
      "command(regex:node .*)",
      "command(regex:git rev-parse( .*)?)",
      "command(regex:git ls-files( .*)?)"
    ],
    "deny": [
      "command(regex:git push( .*)?)",
      "command(regex:git remote( .*)?)",
      "command(regex:git config( .*)?)",
      "command(regex:gh( .*)?)",
      "command(regex:curl( .*)?)",
      "command(regex:wget( .*)?)",
      "command(regex:irm( .*)?)",
      "command(regex:iwr( .*)?)",
      "command(regex:Invoke\\-WebRequest( .*)?)",
      "command(regex:Invoke\\-RestMethod( .*)?)",
      "command(regex:rm( .*)?)",
      "command(regex:del( .*)?)",
      "command(regex:rmdir( .*)?)",
      "command(regex:Remove\\-Item( .*)?)",
      "command(regex:format( .*)?)",
      "command(regex:shutdown( .*)?)",
      "read_url(*)",
      "execute_url(*)",
      "download_url(*)",
      "mcp(*)"
    ]
  }
}
