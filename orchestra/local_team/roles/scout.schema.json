{
  "type": "object",
  "required": ["candidates", "nothing_because"],
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["problem", "evidence", "area_hint", "worth"],
        "additionalProperties": false,
        "properties": {
          "problem": {"type": "string", "minLength": 10, "maxLength": 400},
          "evidence": {"type": "array", "minItems": 1, "maxItems": 5,
                       "items": {"type": "string", "pattern": "^E[0-9]+$"}},
          "area_hint": {"type": "string", "maxLength": 40},
          "worth": {"type": "string", "enum": ["high", "medium", "low"]}
        }
      }
    },
    "nothing_because": {"type": "string", "maxLength": 300}
  }
}
