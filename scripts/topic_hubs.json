{
  "_about": "scripts/topic_hubs.py: the Calendar/Topics hubs that link every chat and session log, rebuilt each night (Chuen, 15 Nov 2026: 'categorise' the orphans in graph view). Every topic word, pattern, anchor note and limit lives here, not in the code. A log goes to the FIRST topic whose patterns match; 'title' patterns test the file name, 'asked' patterns test the file name plus the asked section. The topic with \"fallback\": true takes everything else. Anchors that don't exist in the vault are left out, so a renamed note never becomes a broken link.",
  "folder": "Calendar/Topics",
  "sources": [
    "Calendar/Chats",
    "Calendar/Sessions"
  ],
  "skip_dirs": [
    ".obsidian",
    ".git",
    ".trash"
  ],
  "asked_headings": [
    "What was asked",
    "Asked"
  ],
  "date_pattern": "^(\\d{4}-\\d{2}-\\d{2})",
  "frontmatter_date_key": "date",
  "unescape_pattern": "\\\\([^A-Za-z0-9\\s])",
  "alias_chars": 70,
  "alias_drop_chars": "[]`|\\#^",
  "target_forbidden_chars": "[]|#^\\",
  "split_over": 150,
  "week_format": "{year}-W{week:02d}",
  "separator": " · ",
  "type": "index",
  "tags": [
    "folder-hub",
    "topic-hub"
  ],
  "logs_heading": "Logs",
  "weeks_heading": "Weeks",
  "related_label": "Related:",
  "index": {
    "name": "Topics",
    "description": "Index of the topic hubs that group every chat and session log.",
    "back_label": "Back to",
    "back_to": [
      "Calendar-Index"
    ]
  },
  "describe": {
    "flat": "Topic hub: every chat and session log about {lower} ({count}).",
    "split": "Topic hub: {prefix} chats and sessions ({count}), split by week.",
    "week": "{prefix} logs, week {week} ({count})."
  },
  "commit_message": "Nightly topic hubs: Calendar/Topics rebuilt from the chat and session logs",
