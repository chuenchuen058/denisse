DENISSE_MODEL=llama3.1:8b

# Optional: only needed for voice mode's Inworld neural voice (Veronica).
# Without this, voice mode still works, just with the local system voice.
# Get a key at platform.inworld.ai (free trial, then billed per character).
INWORLD_API_KEY=

# Optional: only needed for Spotify playback control (play/pause/skip by
# voice or chat). Requires a Spotify Premium account. Create a free app at
# developer.spotify.com/dashboard -- redirect URI must be exactly
# http://127.0.0.1:8888/callback -- then paste its Client ID/Secret below.
# First use opens a one-time browser login to authorize; after that it's
# cached in memory/.spotify_cache and never asks again.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
