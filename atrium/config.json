{
  "_note": "Every limit, path, name and sentence the atrium/ modules use (AGENTS.md Rule 0). ATRIUM_CONFIG points at another copy. Paths under \"vault\" are vault-relative, under \"repo\" repo-relative, under \"home\" home-relative. {today}/{date} = YYYY-MM-DD.",

  "vault": {
    "_note": "Used only when DENISSE_VAULT is unset and settings.vault() finds nothing; home-relative.",
    "fallback": "OneDrive - King's College London/Denisse"
  },

  "context": {
    "lanes": ["claude", "codex", "gemini", "copilot", "denisse"],
    "default_lane": "claude",
    "budget": {"claude": 6000, "codex": 4000, "gemini": 8000, "copilot": 2500, "denisse": 2500},
    "default_budget": 4000,
    "header": "# Shared context for {lane} (from Chuen's vault, {now})",
    "header_time": "%Y-%m-%d %H:%M",
    "preamble": "Read-only. Facts here outrank your assumptions; anything missing is unknown.",
    "cut_margin": 40,
    "cut_min_room": 200,
    "cut_whole": "(cut for length; see the vault)",
    "cut_tail": "(... cut for length)",
    "unknown_marker": "- unknown",
    "_parts": "In order: read note -> body (drop front matter) -> section -> strip_heading -> known_only (drop areas whose lines carry unknown_marker) -> bullets (keep the last N if last).",
    "parts": [
      {"title": "Standing asks (Chuen's rules)", "note": "Atlas/Standing-Asks.md", "body": true, "bullets": true},
      {"title": "Before planning anything about Chuen", "note": "Atlas/Concepts/Learning/Learner-Model.md",
       "section": "Before planning anything about Chuen", "known_only": true},
      {"title": "Active right now", "note": "hot.md", "section": "Active right now", "bullets": true},
      {"title": "Waiting on Chuen", "note": "hot.md", "section": "Waiting on Chuen", "bullets": true},
      {"title": "STATE NOW", "note": "STATE NOW.md", "body": true, "strip_heading": "STATE NOW"},
      {"title": "Settled (latest)", "note": "Atlas/Settled.md", "body": true, "bullets": true, "last": 12},
      {"title": "Today's handoff ({today})", "note": "Calendar/Handoff-{today}.md", "bullets": true, "last": 15}
    ]
  },

  "handoff": {
    "note": "Calendar/Handoff-{date}.md",
    "line_chars": 400,
    "time_format": "%H:%M",
    "line": "- {time} [{agent}] {text}",
    "new_note": "---\nname: Handoff-{date}\ndescription: What every agent did on {date}, one line each, tagged with who.\nupdated: {date}\ntype: dated\nstatus: active\ntags: [handoff]\nprotection: append\n---\n\n# Handoff {date}\n\nOne line per decision, correction, hand-off or thing waiting on Chuen, tagged with who wrote it.\n\n## Log\n"
  },

  "credits": {
    "notes": ["Atlas/Settled.md", "Atlas/Standing-Asks.md", "Atlas/Decisions-Log.md"],
    "recent_glob_dir": "Calendar",
    "recent_glob": "Handoff-*.md",
    "default_days": 7,
    "line_chars": 120,
    "tags": ["Chuen", "Claude", "Codex", "Gemini", "Copilot", "Denisse", "measured",
             "claude", "codex", "gemini", "copilot", "denisse", "Claude proposed, Chuen approved"],
    "summary": "{n} decision line(s) without a credit"
  },

  "capture": {
    "every_tokens": 40000,
    "every_tokens_env": "ATRIUM_CAPTURE_EVERY_TOKENS",
    "bytes_per_token": 4,
    "sessions_dir": "Calendar/Sessions",
    "state_file": "Dev/capture-state.json",
    "log_file": "Dev/capture.log",
    "edit_tools": ["Write", "Edit", "MultiEdit"],
    "max_asks": 40,
    "ask_chars": 300,
    "max_answers": 8,
    "answer_chars": 400,
    "max_files": 30,
    "id_chars": 8,
    "default_event": "Stop",
    "threshold_event": "Stop",
    "default_project": "home",
    "ellipsis": "…",
    "reasons": {"Stop": "every {every:,} tokens", "PreCompact": "before compaction", "SessionEnd": "session end"},
    "note_name": "{day} {project} {id}.md",
    "front_matter": ["name: Session-{id}",
                     "description: Claude Code session in {project} on {day}, saved automatically.",
                     "updated: {today}", "type: session", "status: done", "tags: [session, generated]",
                     "protection: append"],
    "title": "# {project} session, {day}",
    "intro": "_Saved automatically by `atrium.capture` ({reason}, ~{tokens:,} tokens). Facts worth keeping go to their home note; this is the record._",
    "asked_heading": "## Asked",
    "answers_heading": "## Last answers",
    "files_heading": "## Files touched",
    "empty": "- (nothing yet)",
    "handoff_agent": "claude",
    "handoff_ask_chars": 120,
    "handoff_no_ask": "—",
    "handoff_line": "session {id} in {project} saved ({reason}): last ask \"{ask}\" → [[{note}]]"
  },

  "hook": {
    "settings_file": ".claude/settings.json",
    "backup_suffix": ".bak-%Y%m%d-%H%M%S",
    "events": {"Stop": "", "PreCompact": "*", "SessionEnd": "*"},
    "command": "\"{repo}/.venv/Scripts/python.exe\" \"{repo}/atrium/hook.py\"",
    "marker": "atrium/hook.py",
    "legacy_marker": "atrium capture",
    "timeout": 20
  },

  "snapshot": {
    "paths": {"review": ".review", "hub": "hub", "orchestra_config": "orchestra/config.json"},
    "_paths": "review and orchestra_config are repo-relative; hub is inside review.",
    "title_chars": 90,
    "archive_days": 7,
    "task_defaults": {"priority": "normal", "lane": "claude"},
    "schedule": {"command": ["schtasks", "/Query", "/TN", "Denisse Orchestra", "/FO", "CSV", "/NH"],
                 "yes": "scheduled every 2 min (runs on mains power)", "no": "not scheduled"},
    "tray": {"command": ["tasklist", "/FI", "IMAGENAME eq pythonw.exe", "/NH"], "image": "pythonw.exe",
             "yes": "running", "no": "not running"},
    "probe_timeout_s": 10,
    "unknown": "unknown",
    "_agents": "status: literal, or {tray}/{schedule}. With login_file: status if that home-relative file exists, else missing. {models} in role = Denisse's configured models.",
    "agents": [
      {"agent": "Claude", "status": "ready", "role": "Main chat: plans, routes, reviews"},
      {"agent": "Codex", "login_file": ".codex/auth.json", "status": "ready", "missing": "sign-in needed",
       "role": "Code changes, debugging, review"},
      {"agent": "Gemini", "login_file": ".gemini/oauth_creds.json", "status": "blocked by Google", "missing": "sign-in needed",
       "role": "Free tier no longer serves Gemini CLI (2 Nov 2026); its jobs go to Codex"},
      {"agent": "Copilot", "login_file": ".copilot/config.json", "status": "ready", "missing": "sign-in needed",
       "role": "GitHub, shell commands, quick code"},
      {"agent": "Denisse", "status": "{tray}", "role": "Local voice assistant ({models}, Kokoro)"},
      {"agent": "Orchestra", "status": "{schedule}", "role": "Runs queued tasks in their own worktrees"}
    ],
    "models": "{chat}, Whisper {whisper}",
    "models_unreadable": "model config unreadable: {error}",
    "waiting": {"section": "Waiting on Chuen", "from": "hot.md", "skip": ["TODO"], "item_chars": 160,
                "reason_chars": 120, "parked_default": "parked",
                "draft": "Approve draft task: {task} (change Queue: draft to auto)",
                "parked": "Parked: {task} - {reason}", "orchestra": "Orchestra",
                "_limit_line": "A note matching this (aftercare's lane-limit line) carries its time as until, and is left out once that time has passed.",
                "limit_line": "^Lane \\w+ limited until (\\d{4}-\\d{2}-\\d{2}[ T]\\d{1,2}:\\d{2})"},
    "log_chars": 220,
    "learner_questions": 4,
    "default_slots": {"claude": 1, "codex": 1},
    "limit_pattern": "(usage limit|rate limit|try again at ([0-9: ]+[AP]M)|IneligibleTierError|quota)",
    "limit_results": ["NO_REPORT", "LIMITED"],
    "lane_logs": 15,
    "lane_log_chars": 4000,
    "lane_log_tail_chars": 800,
    "limit_fresh_hours": 6,
    "runner_log_lines": 300,
    "ollama": {"url": "http://127.0.0.1:11434/api/ps", "timeout_s": 2,
               "loaded": "ready, loaded: {models}", "empty": "ready, no model loaded", "down": "Ollama not running"},
    "_usage": "One row per lane. slots: count this lane's slots. status: fixed status. source ollama: status from Ollama.",
    "usage": [
      {"lane": "claude", "label": "Claude", "plan": "Max plan (allowance not exposed to the CLI)", "slots": true},
      {"lane": "codex", "label": "Codex", "plan": "ChatGPT plan", "slots": true},
      {"lane": "gemini", "label": "Gemini", "plan": "free tier blocked", "slots": true, "status": "blocked by Google"},
      {"lane": "copilot", "label": "Copilot", "plan": "GitHub Copilot"},
      {"lane": "local", "label": "Local (Ollama)", "plan": "on this laptop", "source": "ollama"}
    ],
    "usage_status": {"limited": "limited {limit}", "until": "until {time}", "working": "working ({busy} of {slots})",
                     "available": "available"},
    "_until_format": "How a limit's reset reads in a usage row: until_format when it is today, until_day_format when later. The row's limited_until (ISO with offset) lets the hub page count down and drop it when it passes.",
    "until_format": "%H:%M",
    "until_day_format": "%a %H:%M",
    "bad_status_prefixes": ["limited", "blocked", "Ollama not"],
    "outputs_days": 3,
    "outputs_max": 40,
    "summary_chars": 220,
    "skip_results": ["NO_REPORT"],
    "activity_days": 7,
    "activity_lanes": ["claude", "codex"]
  },

  "chatlog": {
    "_note": "The day's chat note and the one handoff line per save, shared by `python -m atrium digest` and `python -m atrium hub-save` (was .review/hub_digest.py). Each writer appends under its own heading, so neither touches the other's entries. Only the chat note and the handoff note are committed. {date} = YYYY-MM-DD, {time} = time_format.",
    "note": "Calendar/Chats/{date} claude hub.md",
    "time_format": "%H:%M",
    "new_note": "---\nname: \"{date} claude hub\"\ndescription: \"Digest of the Claude hub chat (the one chat Chuen uses to run Denisse, Orchestra, Don and UROP) and of the laptop side on {date}, saved as it goes.\"\nupdated: {date}\ntype: chat\nsource: claude-hub\ndate: {date}\ntags: [chat, claude, hub]\n---\n\n# {date} Claude hub\n",
    "never_write": [".obsidian"],
    "git": ["git"],
    "git_timeout_s": 60,
    "writers": {
      "hub": {"heading": "## Saved {time}", "agent": "claude",
              "handoff": "hub chat digest saved -> [[{stem}]]",
              "commit": "Claude hub: chat digest {date} {time}"},
      "atrium": {"heading": "## Laptop digest {time} (Atrium, since {since})", "agent": "atrium",
                 "handoff": "laptop digest saved ({lines} line(s): {sections}) -> [[{stem}]]",
                 "commit": "Atrium: laptop digest {date} {time}"}
    }
  },

  "digest": {
    "_note": "python -m atrium digest [--since HOURS] [--dry]: what happened on this laptop since the last digest. Sections are written in the order listed and a section with no lines is left out. When no section with counts_as_activity has a line, nothing is written (the state still moves on). log/review are repo-relative; state_file and globs are vault-relative.",
    "state_file": "Dev/digest-state.json",
    "first_run_hours": 1,
    "max_lines": 40,
    "section_max_lines": 10,
    "line_chars": 200,
    "ellipsis": "…",
    "more": "- (+{n} more)",
    "section_heading": "### {title}",
    "since_format": "%Y-%m-%d %H:%M",
    "nothing": "nothing happened since {since}; nothing written",
    "dry_header": "(dry run: nothing written, state unchanged)",
    "saved": "saved {note}",
    "sections": [
      {"kind": "runner", "title": "Orchestra", "counts_as_activity": true, "log": ".review/runner.log",
       "_events": "Orchestra's runner.log line format: '<ISO time> <WORD> <task>[:] <rest>'. WORD -> the label it is listed under (in this order), or -> {what <rest> starts with: label} when the outcome is in the rest; other words and outcomes are ignored.",
       "events": {"START": "started", "PASS": "passed", "PARTIAL": "partial", "FAIL": "failed",
                  "PARKED": "parked",
                  "merge": {"merged": "merged", "parked": "merge parked"},
                  "push": {"pushed": "pushed", "not pushed": "not pushed", "push failed": "push failed"},
                  "LIMITED": "hit a limit"},
       "task_strip": ["review/", ":"],
       "line": "- {label}: {items}",
       "spend_events": ["PASS", "PARTIAL", "FAIL"],
       "spend_pattern": "\\$([0-9]+(?:\\.[0-9]+)?)\\)",
       "spend": "- spend: ${total:.2f} over {runs} run(s) with a known cost"},
      {"kind": "git", "title": "Denisse repo", "counts_as_activity": true, "where": "repo",
       "args": ["log", "--no-merges", "--format=%cI%x09%h%x09%s"],
       "line": "- `{hash}` {subject}", "skip_prefixes": []},
      {"kind": "git", "title": "Vault", "counts_as_activity": true, "where": "vault",
       "args": ["log", "--no-merges", "--format=%cI%x09%h%x09%s"],
       "line": "- `{hash}` {subject}",
       "_skip_prefixes": "Subjects starting with one of these are left out: the digests' own commits, so a digest never reports the last one.",
       "skip_prefixes": ["Atrium: laptop digest", "Claude hub: chat digest"]},
      {"kind": "pages", "title": "Don's pages changed", "counts_as_activity": true,
       "globs": ["Atlas/Academic/Study Progress.md", "Atlas/Academic/SEM 1 Modules/**/*.md"],
       "line": "- [[{stem}]]"},
      {"kind": "queue", "title": "Queue", "counts_as_activity": false, "review": ".review",
       "waiting": "- waiting: {n} task(s){titles}", "titles_sep": ", ", "titles_lead": ": ", "titles_max": 5,
       "draft": "- needs Chuen: approve draft {task} (Queue: draft -> auto)",
       "parked": "- needs Chuen: parked {task}",
       "auto": "auto", "title_chars": 90}
    ]
  },

  "install_digest": {
    "_note": "atrium/install_digest.py: the hourly Windows scheduled task for the digest. Prints the command; only --register runs it. python and script are repo-relative.",
    "task_name": "Denisse Atrium Digest",
    "python": ".venv/Scripts/pythonw.exe",
    "script": "atrium/digest_task.py",
    "log_file": "Dev/digest.log",
    "create": ["schtasks", "/Create", "/F", "/SC", "HOURLY", "/MO", "1", "/TN", "{name}", "/TR", "\"{python}\" \"{script}\""]
  },

  "_app": "scripts/atrium_app.pyw (Chuen, 12 Nov 2026: an app for the hub that stays live): starts `atrium live` when it is not answering, then opens the page in its own window. browsers = tried in order (%VARS% expanded, bare names looked up on PATH); --app gives a window without tabs.",
  "app": {"browsers": ["%ProgramFiles(x86)%\\Microsoft\\Edge\\Application\\msedge.exe", "%ProgramFiles%\\Microsoft\\Edge\\Application\\msedge.exe", "msedge", "%ProgramFiles%\\Google\\Chrome\\Application\\chrome.exe", "chrome"], "browser_args": ["--window-size=1280,860"], "probe_timeout_s": 2, "start_wait_s": 20},
  "live": {
    "_note": "python -m atrium live: the laptop's own live Atrium page (atrium/live.py, page in atrium/live_page/). Read-only: it serves what atrium/snapshot.py collects and never writes. host must be one of loopback. Work happens only while a browser tab holds the event stream open: every poll_s the watched files are stat'ed and the data rebuilt when one changed (or refresh_s passed, for limits that lift with the clock).",
    "host": "127.0.0.1",
    "port": 8777,
    "loopback": [
      "127.0.0.1",
      "::1",
      "localhost"
    ],
    "poll_s": 2,
    "refresh_s": 60,
    "keepalive_s": 15,
    "page_dir": "live_page",
    "tables": [
      "tasks",
      "waiting",
      "spend",
      "running",
      "usage"
    ],
    "_watch": "review: globs inside .review (a folder counts its entries and their subfolders); vault: vault-relative files.",
    "watch": {
      "review": [
        "state.json",
        "runner.log",
        "campaign.json",
        "config.json",
        "runner.*.lock",
        "queue",
        "parked",
        "archive",
        "exams/scores.json"
      ],
      "vault": [
        "hot.md"
      ]
    },
    "panels": [
      "agents",
      "needs",
      "cursors",
      "timeline",
      "progress",
      "markets"
    ],
    "headings": {"agents": "Agents", "needs": "Needs you", "cursors": "Where they are", "files": "Files in play", "timeline": "Today", "progress": "Progress", "markets": "Markets"},
    "title": "Atrium Live",
    "subtitle": "What's happening in the background",
    "_agents": "One bar and one timeline row each, in this order. lane = the Orchestra lane (snapshot usage rows); colour = the accent used everywhere that agent appears.",
    "agents": [
      {
        "lane": "claude",
        "label": "Claude",
        "colour": "#e8875b"
      },
      {
        "lane": "copilot",
        "label": "Copilot",
        "colour": "#a78bfa"
      },
      {
        "lane": "codex",
        "label": "Codex",
        "colour": "#5fb3f2"
      },
      {
        "lane": "local",
        "label": "Don",
        "colour": "#4fd1a5"
      }
    ],
    "needs_max": 3,
    "_needs": "Overlaps (two agents in one file, from cursors below) come first: they need you before a merge does.",
    "needs_icons": {
      "overlap": "⚠",
      "note": "⌘",
      "draft": "✎",
      "parked": "⏸"
    },
    "_cursors": "atrium/cursors.py: one pointer per running task, in its agent's colour, on its task row and on the file its worktree touched last; every touched file listed once (shared first, then newest, at most max_files) with who is in it. A file two agents both touch is an overlap: one warning per file, also in Needs you. worktrees = the runner's worktree folder ({repo_parent}, {repo_name} of this checkout; orchestra/runner.py WORKTREES); touched = committed since merge-base with base_ref + uncommitted + untracked, read-only (git_env: no index refresh). Ignored: the runner's own orchestra/config.json <runner_ignore_key> prefixes when use_runner_ignores, plus ignore (globs on the path or the file name). Cached per worktree for refresh_s, so the page's existing loop is the only one. page: the keys sent to app.js (pixel sizes, glide time); the glide is one CSS transition, none under prefers-reduced-motion or when a hidden tab comes back.",
    "cursors": {
      "worktrees": "{repo_parent}/{repo_name}-wt",
      "base_ref": "master",
      "git_timeout_s": 5,
      "git_env": {"GIT_OPTIONAL_LOCKS": "0", "GIT_TERMINAL_PROMPT": "0"},
      "use_runner_ignores": true,
      "runner_ignore_key": "conflict_ignore_prefixes",
      "ignore": [".review/*", "__pycache__/*", "*/__pycache__/*", "*.pyc", ".pytest_cache/*", "*/.pytest_cache/*",
                 ".mypy_cache/*", ".ruff_cache/*", "graphify-out/*", "*.log", "*.tmp"],
      "max_files": 8,
      "arrow_px": 13,
      "tag_px": 10.5,
      "row_px": 26,
      "glide_ms": 350,
      "page": ["arrow_px", "tag_px", "row_px", "glide_ms"]
    },
    "timeline": {
      "start_hour": 10,
      "end_hour": 19,
      "pad_hours": 1,
      "tick_hours": 3,
      "_classes": "result -> colour class (ok/warn/bad); a run still going is drawn in its agent's colour.",
      "classes": {
        "PASS": "ok",
        "PARTIAL": "warn"
      },
      "default_class": "bad"
    },
    "progress": {
      "done_results": [
        "PASS"
      ],
      "bars": [
        {
          "key": "tasks",
          "label": "Tasks today",
          "colour": "ok",
          "text": "{v} of {m} done"
        },
        {
          "key": "study",
          "label": "Study notes written",
          "colour": "#5fb3f2",
          "text": "{v} of {m} weeks"
        },
        {
          "key": "spend",
          "label": "Spend today",
          "colour": "#e8875b",
          "text": "${v:.0f} of ${m:.0f}"
        }
      ]
    },
    "_study": "Week notes written of weeks filed: every week_glob folder under each module in root (vault-relative) is filed; it is written when it holds a note_glob file of at least written_min_chars characters.",
    "study": {
      "root": "Atlas/Academic/SEM 1 Modules",
      "week_glob": "Week *",
      "note_glob": "*Week*.md",
      "written_min_chars": 800
    },
    "_board": "The v3 mission board (atrium/board.py builds and renders it from what live.collect() read; layout after atrium/design/mission-board-reference.html, none of its sample text). cards: the grid, in order; id = a section atrium/board.py knows, class = layout classes from style.css (span2, span4, tall); \"lanes\" becomes one card per entry of \"agents\" above. Every word, colour, regex for the runner's log lines and limit lives here. theme: CSS variables per colour scheme, set by app.js. favicon: one arc per agent in its colour, centre dot = the verdict's colour (theme ok/warn/bad of favicon.scheme).",
    "board": {
      "title": "Atrium hub",
      "cards": [
        {"id": "lanes", "class": ""},
        {"id": "tree", "class": "span4"},
        {"id": "local", "class": "span4"},
        {"id": "cursors", "class": "span2 tall"},
        {"id": "merged", "class": ""},
        {"id": "needs_look", "class": ""},
        {"id": "up_next", "class": "span2"},
        {"id": "tokens", "class": "span4"},
        {"id": "credits", "class": "span4"},
        {"id": "limits", "class": "span2"},
        {"id": "activity", "class": "span2"},
        {"id": "today", "class": "span2"},
        {"id": "projects", "class": "span2"},
        {"id": "progress", "class": "span2"},
        {"id": "markets", "class": "span2"}
      ],
      "headings": {
        "tree": "What to work on", "local": "Local agents · on this laptop", "cursors": "Live · who's editing what",
        "merged": "Merged today", "needs_look": "⚠︎ Needs a look", "up_next": "Up next", "tokens": "Tokens spent",
        "credits": "Credits per task · today", "limits": "Limits & resets", "activity": "Live activity",
        "today": "Today", "projects": "Projects", "progress": "Progress", "markets": "Markets"
      },
      "theme": {
        "light": {"bg": "#f2f2f7", "card": "#ffffff", "text": "#1c1c1e", "sub": "#6e6e73", "line": "#e5e5ea",
                  "ok": "#34c759", "warn": "#ff9f0a", "bad": "#ff3b30", "later": "#c7c7cc", "on-accent": "#ffffff",
                  "shadow": "rgba(0,0,0,.06)"},
        "dark": {"bg": "#000000", "card": "#1c1c1e", "text": "#f5f5f7", "sub": "#98989d", "line": "#2c2c2e",
                 "ok": "#34c759", "warn": "#ff9f0a", "bad": "#ff3b30", "later": "#48484a", "on-accent": "#ffffff",
                 "shadow": "rgba(0,0,0,.4)"}
      },
      "theme_storage_key": "atrium-theme",
      "favicon": {"scheme": "light", "bg_top": "#2c2c2e", "bg_bottom": "#0b0b0d", "size": 64, "corner": 15,
                  "radius": 19, "stroke": 6, "dot": 6},
      "clock": {"locale": "en-GB", "date": {"weekday": "long", "day": "numeric", "month": "long"},
                "time": {"hour": "2-digit", "minute": "2-digit"}, "join": " · ", "tick_ms": 1000},
      "_rings": "The four rings, in order. key = a figure atrium/board.py computes (pass, slots, ready, spend); colour = a theme variable or an agent's lane (its colour). value/label are filled with v (the count), m (out of), pct; empty = shown when m is 0 (nothing to measure).",
      "rings": [
        {"key": "pass", "colour": "ok", "value": "{pct}%", "label": "pass rate today · {v} of {m}", "empty": "no runs finished today"},
        {"key": "slots", "colour": "lane:codex", "value": "{v} of {m}", "label": "slots in use", "empty": "no slots configured"},
        {"key": "ready", "colour": "lane:copilot", "value": "{v} of {m}", "label": "agents ready", "empty": "no agents configured"},
        {"key": "spend", "colour": "lane:claude", "value": "${v:.0f}", "label": "of ${m:.0f} today · notional", "empty": "no spend cap set"}
      ],
      "ring": {"radius": 15, "stroke": 4, "box": 36},
      "_runner_log": "The runner's own line format (.review/runner.log: '<ISO time> <rest>'); each regex is matched against <rest>. start_line gives a running task's timeout; merged_line counts today's merges; consult_line is Don's consult.",
      "runner_log": {
        "file": "runner.log",
        "lines": 400,
        "start_line": "^START (?P<task>\\S+) lane=(?P<lane>\\w+) .*?timeout=(?P<timeout>\\d+)s",
        "merged_line": "^merge review/(?P<task>[^:]+): merged",
        "consult_line": "^CONSULT (?P<task>[^:]+):.*-> (?P<confidence>\\w+) confidence by (?P<by>\\w+)"
      },
      "_activity": "The feed: the newest max lines of runner.log that match one of events (first match wins), newest first. text is filled with the regex's named groups plus title (the task's title) and label (the lane's agent label). Lines that match nothing are not shown.",
      "activity": {
        "max": 8,
        "text_chars": 110,
        "time_today": "%H:%M",
        "time_other": "%d %b",
        "events": [
          {"pattern": "^START (?P<task>\\S+) lane=(?P<lane>\\w+)", "text": "{label} started: {title}"},
          {"pattern": "^(?P<word>PASS|PARTIAL|FAIL) (?P<task>\\S+) after (?P<seconds>\\d+)s", "text": "{word}: {title}"},
          {"pattern": "^PARKED (?P<task>[^:]+):", "text": "Parked: {title}"},
          {"pattern": "^merge review/(?P<task>[^:]+): merged", "text": "✓ Merged: {title}"},
          {"pattern": "^LIMITED (?P<task>\\S+) lane=(?P<lane>\\w+) until (?P<until>.+)$", "text": "{label} limited until {until}"},
          {"pattern": "^CONSULT (?P<task>[^:]+):.*-> (?P<confidence>\\w+) confidence", "text": "Don gave an opinion ({confidence} confidence): {title}"},
          {"pattern": "^REQUEUED (?P<task>[^:]+):", "text": "Requeued: {title}"}
        ]
      },
      "lane_card": {"max_tasks": 2, "bar_full_pct": 100},
      "up_next": {"max": 4, "priority_order": ["urgent", "high", "normal", "low"]},
      "_tree": "What to work on: one branch per group. source hot = the bullets of a hot.md section (struck ~~lines~~ are done; the block between skip_block markers is Orchestra's own copy of the queue and is left out); source queue = Orchestra's task files by status. classes: u urgent, s open, l later, d done (legend, in that order).",
      "tree": {
        "note": "hot.md",
        "item_chars": 70,
        "max_open": 6,
        "max_done": 2,
        "done_pattern": "^~~(?P<text>.+?)~~",
        "skip_block": ["<!-- orchestra:waiting -->", "<!-- /orchestra:waiting -->"],
        "skip": ["TODO"],
        "open_class": "s",
        "done_class": "d",
        "groups": [
          {"title": "Waiting on you", "source": "hot", "section": "Waiting on Chuen"},
          {"title": "Orchestra", "source": "queue",
           "statuses": [{"status": "queued", "label": "Queued", "class": "s"},
                        {"status": "parked", "label": "Parked", "class": "u"},
                        {"status": "draft", "label": "Drafts to approve", "class": "l"}],
           "urgent_priorities": ["urgent"], "urgent_class": "u", "max_per_status": 4}
        ],
        "legend": [{"class": "u", "text": "urgent / parked"}, {"class": "s", "text": "open"},
                   {"class": "l", "text": "later"}, {"class": "d", "text": "done"}]
      },
      "_local": "Local agents: one tile per entry, in order; kind = what atrium/board.py reads for it (ollama: /api/ps at snapshot.ollama.url; gpu: gpu_command's first line as 'busy %, MiB used, MiB total'; don: today's consult lines in runner.log; evals: .review/<evals_file>, the agents whose name starts with evals_prefix; digest: the vault's digest.state_file). Each read is cached for cache_s. A tile with nothing to read shows the empty word, never a number.",
      "local": {
        "cache_s": 30,
        "gpu_command": ["nvidia-smi", "--query-gpu=utilization.gpu,memory.used,memory.total", "--format=csv,noheader,nounits"],
        "gpu_timeout_s": 3,
        "mib_per_gb": 1024,
        "bytes_per_gb": 1073741824,
        "evals_file": "exams/last_run.json",
        "evals_prefix": "local:",
        "time_today": "%H:%M",
        "time_other": "%d %b %H:%M",
        "tiles": [
          {"kind": "ollama", "name": "Ollama"},
          {"kind": "gpu", "name": "GPU"},
          {"kind": "don", "name": "Don"},
          {"kind": "evals", "name": "Local evals"},
          {"kind": "digest", "name": "Atrium digest"}
        ],
        "words": {
