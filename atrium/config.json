      "_projects": "Projects: the bullets of a hot.md section; lead_pattern splits off a leading date and [who].",
      "projects": {"note": "hot.md", "section": "Active right now", "max": 5, "item_chars": 110, "skip": ["TODO"],
                   "lead_pattern": "^(?:(?P<date>\\d{4}-\\d{2}-\\d{2})\\s*)?(?:\\[(?P<who>[^\\]]+)\\]\\s*)?(?P<text>.*)$"},
