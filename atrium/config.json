          "vram": "{used:.1f} GB in VRAM",
          "gpu_busy": "{pct}% busy", "gpu_mem": "{used:.1f} / {total:.1f} GB VRAM",
          "consults": "{n} consult(s) today", "no_consults": "no consults today",
          "last_consult": "last {time} · {confidence} confidence",
          "evals": "{v} of {m} passed", "eval_row": "{name} {result}", "eval_join": " · ", "evals_last": "last run {time}",
          "digest_last": "last saved {time}"
        }
      },
      "_tokens": "Tokens spent: summed from the runner's record of each finished run (state.json history -> tokens: in, out, cache_read, cache_write). fresh = in + out. Lanes that report no tokens are listed as unknown, never as 0. units: largest first.",
      "tokens": {
        "week_days": 7,
        "fresh_keys": ["in", "out"],
        "all_keys": ["in", "out", "cache_read", "cache_write"],
        "units": [[1000000000, "B"], [1000000, "M"], [1000, "k"]],
        "unit_format": "{n:.1f}{unit}",
        "periods": [
